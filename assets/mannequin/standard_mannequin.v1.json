{
  "id": "standard_mannequin_v1",
  "version": 2,
  "status": "ready",
  "displayName": "Standard Premium Mannequin",
  "model": {
    "format": "glb",
    "path": "assets/mannequin/standard_female_v1.glb",
    "scale": 1.0,
    "defaultPose": "a_pose",
    "defaultCamera": {
      "target": [0.0, 1.05, 0.0],
      "distance": 3.2,
      "fieldOfView": 28.0
    }
  },
  "camera": {
    "initialYaw": 0,
    "initialPitch": -5,
    "initialZoom": 1.0,
    "minZoom": 0.7,
    "maxZoom": 1.5,
    "orbitSensitivity": 1.0
  },
  "lighting": {
    "ambientIntensity": 0.85,
    "directionalIntensity": 1.2,
    "directionalColor": "#FFFFFF",
    "environmentImage": null,
    "shadowEnabled": true,
    "shadowSoftness": 0.6
  },
  "renderSettings": {
    "quality": "high",
    "antiAlias": true,
    "toneMappingExposure": 1.1,
    "backgroundAlpha": 0.0
  },
  "rig": {
    "skeleton": "humanoid",
    "requiredBones": [
      "hips",
      "spine",
      "chest",
      "neck",
      "head",
      "leftUpperArm",
      "leftLowerArm",
      "rightUpperArm",
      "rightLowerArm",
      "leftUpperLeg",
      "leftLowerLeg",
      "rightUpperLeg",
      "rightLowerLeg",
      "leftFoot",
      "rightFoot"
    ]
  },
  "garmentSlots": [
    {
      "id": "upper_body",
      "category": "Top",
      "anchorBone": "chest",
      "layerOrder": 20,
      "wrapMode": "torso_front",
      "zIndex": 30,
      "perspectiveWeight": 0.85,
      "overlayAnchor": {
        "topRatio": 0.12,
        "centerXRatio": 0.50,
        "widthRatio": 0.52,
        "heightRatio": 0.34
      }
    },
    {
      "id": "lower_body",
      "category": "Bottom",
      "anchorBone": "hips",
      "layerOrder": 15,
      "wrapMode": "legs_front",
      "zIndex": 20,
      "perspectiveWeight": 0.75,
      "overlayAnchor": {
        "topRatio": 0.45,
        "centerXRatio": 0.50,
        "widthRatio": 0.42,
        "heightRatio": 0.38
      }
    },
    {
      "id": "outerwear",
      "category": "Outerwear",
      "anchorBone": "chest",
      "layerOrder": 25,
      "wrapMode": "torso_full",
      "zIndex": 35,
      "perspectiveWeight": 0.90,
      "overlayAnchor": {
        "topRatio": 0.10,
        "centerXRatio": 0.50,
        "widthRatio": 0.58,
        "heightRatio": 0.52
      }
    },
    {
      "id": "feet",
      "category": "Shoes",
      "anchorBone": "leftFoot",
      "secondaryAnchorBone": "rightFoot",
      "layerOrder": 10,
      "wrapMode": "feet_pair",
      "zIndex": 10,
      "perspectiveWeight": 0.60,
      "overlayAnchor": {
        "topRatio": 0.85,
        "centerXRatio": 0.50,
        "widthRatio": 0.38,
        "heightRatio": 0.14
      }
    }
  ],
  "motion": {
    "supportsWind": false,
    "windAffectedZones": ["hem", "sleeve_edge", "outerwear_edge"]
  },
  "notes": [
    "V2: Extended schema with camera, lighting, renderSettings and overlayAnchor.",
    "overlayAnchor defines where 2D garment images are composited onto the 3D scene.",
    "perspectiveWeight controls how strongly yaw rotation affects garment skew."
  ]
}
